# ============================================================
# Options Greeks Calculator - Environment Configuration
# ============================================================

# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================
ENVIRONMENT=development
# development: Enable debug, verbose logging, CORS permissive
# production: Disable debug, security headers, strict logging

DEBUG=false
# Set to true only in development. NEVER in production!

# ============================================================
# SERVER CONFIGURATION
# ============================================================
HOST=0.0.0.0
PORT=8000

# ============================================================
# API CONFIGURATION
# ============================================================
API_TITLE=Options Greeks Calculator API
API_VERSION=1.0.0
API_DESCRIPTION=Calculate options Greeks using Black-Scholes model

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs
LOG_FORMAT=json
# json: Structured logging for monitoring tools
# standard: Human-readable logging

# ============================================================
# CORS CONFIGURATION (Important for production!)
# ============================================================
# Set this to your frontend domain(s) in production
# Multiple domains: https://domain1.com,https://domain2.com
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ============================================================
# SECURITY CONFIGURATION
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
# Allow 100 requests per 60 seconds per IP

# Security headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
# Strict-Transport-Security: max-age in seconds (default: 1 year)

# ============================================================
# MARKET DATA CONFIGURATION
# ============================================================
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_TIMEOUT=30
# Timeout in seconds for market data API calls

MARKET_DATA_CACHE_ENABLED=true
MARKET_DATA_CACHE_TTL=300
# Cache market data for 5 minutes (300 seconds)

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
VITE_API_URL=http://localhost:8000/api
# In production: https://your-domain.com/api
VITE_ENV=development

# ============================================================
# DATABENTO (Market Outlook page: OPRA option chains)
# ============================================================
# Key from https://databento.com/portal/keys. Without it the outlook page
# falls back to CHAIN_SOURCE (Yahoo) and says so.
DATABENTO_API_KEY=
# Databento bills per download. Each request is priced first and refused
# if it would take today's live spend over this cap (backtests keep their
# own ledger). About $1/day covers the 10-symbol watchlist.
DATABENTO_DAILY_BUDGET_USD=1.50
# Downloads are cached here and never paid for twice.
# DATABENTO_CACHE_DIR=data_cache/databento
# Symbols the outlook page loads (and the backend prefetches).
# OUTLOOK_WATCHLIST=SPY,QQQ,NVDA,TSLA,AAPL,AMD,META,MSFT,AMZN,IWM
# Set to 0 to stop the backend warming the watchlist in the background.
# OUTLOOK_PREFETCH=1

# ============================================================
# DATABASE CONFIGURATION (for future features)
# ============================================================
DATABASE_URL=sqlite:///./greeks_calculator.db
# For production, use: postgresql://user:password@host:5432/dbname

# ============================================================
# MONITORING & OBSERVABILITY
# ============================================================
# Optional: APM/Monitoring service integrations
DATADOG_ENABLED=false
DATADOG_API_KEY=
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_MARKET_DATA_FETCH=true
ENABLE_SURFACE_VISUALIZATION=true
ENABLE_HISTORY_PERSISTENCE=true

# ============================================================
# OPTIONS MARKET SCANNER
# ============================================================
CHAIN_SOURCE=yahoo
# yahoo: live delayed chains via yfinance | synthetic: offline demo data
RISK_FREE_RATE=0.04
ANALYTICS_CACHE_TTL=300
